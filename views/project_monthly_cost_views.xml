<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_toptech_project_monthly_cost_form" model="ir.ui.view">
        <field name="name">toptech.project.monthly.cost.form</field>
        <field name="model">toptech.project.monthly.cost</field>
        <field name="arch" type="xml">
            <form string="Monthly Cost Breakdown">
                <sheet>
                    <group>
                        <group string="Period &amp; Project">
                            <field name="project_id"/>
                            <field name="month_date"/>
                            <field name="month_name"/>
                            <field name="cost_type"/>
                        </group>
                        <group string="Monthly Financial Breakdown">
                            <field name="salary_cost" widget="monetary"/>
                            <field name="expense_cost" widget="monetary"/>
                            <field name="overhead_cost" widget="monetary"/>
                            <field name="total_cost" widget="monetary"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_toptech_project_monthly_cost_list" model="ir.ui.view">
        <field name="name">toptech.project.monthly.cost.list</field>
        <field name="model">toptech.project.monthly.cost</field>
        <field name="arch" type="xml">
            <list string="Monthly Cost Breakdown" editable="bottom">
                <field name="project_id"/>
                <field name="month_name"/>
                <field name="month_date"/>
                <field name="salary_cost" widget="monetary"/>
                <field name="expense_cost" widget="monetary"/>
                <field name="overhead_cost" widget="monetary"/>
                <field name="total_cost" widget="monetary"/>
                <field name="cost_type"/>
            </list>
        </field>
    </record>

    <record id="action_toptech_project_monthly_cost" model="ir.actions.act_window">
        <field name="name">Monthly Cost Breakdown</field>
        <field name="res_model">toptech.project.monthly.cost</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
