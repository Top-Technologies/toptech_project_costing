<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_resource_cost_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center mb-4">
                            <h2 style="color: #1f4e78; font-weight: bold;">TopTech Resource Cost Report</h2>
                            <h4><span t-field="doc.name"/> (<span t-field="doc.reference"/>)</h4>
                        </div>

                        <table class="table table-bordered table-sm mt-3">
                            <thead class="table-dark">
                                <tr>
                                    <th>Resource Name</th>
                                    <th>Position / Role</th>
                                    <th class="text-end">Monthly Cost</th>
                                    <th class="text-center">Alloc %</th>
                                    <th class="text-center">Months</th>
                                    <th class="text-end">Planned Cost</th>
                                    <th class="text-end">Actual Cost</th>
                                    <th class="text-end">Total Resource Cost</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.resource_ids" t-as="res">
                                    <tr>
                                        <td><span t-field="res.name"/></td>
                                        <td><span t-field="res.position"/></td>
                                        <td class="text-end"><span t-field="res.monthly_cost" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                        <td class="text-center"><span t-field="res.allocation_percentage"/>%</td>
                                        <td class="text-center"><span t-field="res.number_of_months"/></td>
                                        <td class="text-end"><span t-field="res.planned_cost" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                        <td class="text-end"><span t-field="res.actual_cost" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                        <td class="text-end"><span t-field="res.resource_cost" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                    </tr>
                                </t>
                                <tr class="table-secondary fw-bold">
                                    <td colspan="5" class="text-end">Total Resource Costs:</td>
                                    <td class="text-end"><span t-field="doc.planned_resource_cost" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                    <td class="text-end"><span t-field="doc.actual_resource_cost" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                    <td class="text-end"><span t-field="doc.resource_cost" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
