<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_overhead_allocation_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center mb-4">
                            <h2 style="color: #1f4e78; font-weight: bold;">TopTech Overhead Allocation Report</h2>
                            <h4><span t-field="doc.name"/> (<span t-field="doc.date_start"/> to <span t-field="doc.date_end"/>)</h4>
                        </div>

                        <div class="row mb-3 p-3" style="background-color: #f8f9fa; border: 1px solid #dee2e6;">
                            <div class="col-6">
                                <strong>Rent:</strong> <span t-field="doc.rent" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/><br/>
                                <strong>Electricity:</strong> <span t-field="doc.electricity" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/><br/>
                                <strong>Internet:</strong> <span t-field="doc.internet" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                            </div>
                            <div class="col-6">
                                <strong>Office Expenses:</strong> <span t-field="doc.office_expenses" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/><br/>
                                <strong>Administration:</strong> <span t-field="doc.administration" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/><br/>
                                <strong>Management:</strong> <span t-field="doc.management" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                            </div>
                        </div>
                        <h5 class="text-end text-primary mb-3">Total Overhead Pool: <span t-field="doc.total_overhead" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></h5>

                        <table class="table table-bordered table-sm mt-3">
                            <thead class="table-dark">
                                <tr>
                                    <th>Project Name</th>
                                    <th>Allocation Method</th>
                                    <th class="text-center">Allocation %</th>
                                    <th class="text-end">Allocated Amount</th>
                                    <th>Cost Type</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.allocation_ids" t-as="alloc">
                                    <tr>
                                        <td><span t-field="alloc.project_id.name"/></td>
                                        <td><span t-field="alloc.allocation_method"/></td>
                                        <td class="text-center"><span t-field="alloc.allocation_percentage"/>%</td>
                                        <td class="text-end"><span t-field="alloc.allocated_amount" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                        <td><span t-field="alloc.cost_type"/></td>
                                    </tr>
                                </t>
                                <tr class="table-secondary fw-bold">
                                    <td colspan="3" class="text-end">Total Allocated:</td>
                                    <td class="text-end"><span t-field="doc.allocated_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                    <td></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
